			<string>key</string>
			<key>service</key>
			<string>Bark</string>
			<key>label</key>
			<string>Key:</string>
			<key>noAutoCorrect</key>
			<true/>
		</dict>

		<!-- Options -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
