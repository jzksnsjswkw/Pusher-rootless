<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Use the authorization code from the mailbox settings, not the login password. Every recipient listed below receives the mail.</string>
			<key>label</key>
			<string>Credentials</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>key</key>
			<string>fromEmail</string>
			<key>label</key>
			<string>From:</string>
			<key>noAutoCorrect</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>isSecure</key>
			<true/>
			<key>key</key>
			<string>password</string>
			<key>label</key>
			<string>Password:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>A sender name is what the recipient sees beside the address. A subject you write here replaces the notification title, which then moves into the body.</string>
			<key>label</key>
			<string>Options</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>key</key>
			<string>senderName</string>
			<key>label</key>
			<string>Sender name:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>key</key>
			<string>subject</string>
			<key>label</key>
			<string>Subject:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Default takes all three from the sender address. SSL uses port 465, STARTTLS uses 587, None uses 25. A server typed here is used as given.</string>
			<key>label</key>
			<string>Server</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>key</key>
			<string>host</string>
			<key>label</key>
			<string>Host:</string>
			<key>noAutoCorrect</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>key</key>
			<string>port</string>
			<key>keyboardType</key>
			<string>numbersAndPunctuation</string>
			<key>label</key>
			<string>Port:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSegmentCell</string>
			<key>defaults</key>
			<string>com.noahsaso.pusher</string>
			<key>detail</key>
			<string>PSListItemsController</string>
			<key>key</key>
			<string>security</string>
			<key>validTitles</key>
			<array>
				<string>None</string>
				<string>SSL</string>
				<string>STARTTLS</string>
			</array>
			<key>validValues</key>
			<array>
				<string>plain</string>
				<string>tls</string>
				<string>starttls</string>
			</array>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Apps</string>
		</dict>
		<dict>
			<key>PostNotification</key>
			<string>com.noahsaso.pusher/prefs</string>
			<key>cell</key>
			<string>PSSegmentCell</string>
			<key>defaults</key>
			<string>com.noahsaso.pusher</string>
			<key>detail</key>
			<string>PSListItemsController</string>
			<key>key</key>
			<string>appListIsBlacklist</string>
			<key>validTitles</key>
			<array>
				<string>Blacklist</string>
				<string>Whitelist</string>
			</array>
			<key>validValues</key>
			<array>
				<true/>
				<false/>
			</array>
		</dict>
		<dict>
			<key>alphabeticIndexingEnabled</key>
			<true/>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>detail</key>
			<string>NSPAppListController</string>
			<key>icon</key>
			<string>app_list</string>
			<key>label</key>
			<string>App List</string>
			<key>useSearchBar</key>
			<true/>
		</dict>
	</array>
</dict>
</plist>
